# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=

# 관리자 유저 ID (쉼표 구분, /stats 등 관리자 명령어 허용)
ADMIN_USER_IDS=

# 자동발송 대상 채널/공지방 ID
# 채널은 음수값: 예) -1001234567890
# 뉴스, 김프, 경제캘린더 자동발송에 사용
ANNOUNCE_CHAT_ID=

# 키움증권 REST API (https://openapi.kiwoom.com) — /au 국내주식 종목검색·차트
# 이 파일을 .env 로 복사해 실제 값을 채우세요. .env 는 Git 에 올라가지 않습니다 (chmod 600 권장).
# 읽는 순서: 환경변수 → 프로젝트 폴더의 .env → (구버전) *_appkey.txt / *_secretkey.txt
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# 한국투자증권 OpenAPI (https://apiportal.koreainvestment.com)
# 현재가/등락률/거래량 실시간 조회용
# 미설정 시 pykrx 마지막 종가로 자동 fallback
KIS_APP_KEY=
KIS_APP_SECRET=
